log_format safe '$remote_addr - $remote_user [$time_local] '
                 '"$safe_method $safe_uri $server_protocol" $status $body_bytes_sent '
                 '"$http_referer" "$http_user_agent" rt=$request_time';

map $request_method $safe_method {
    default $request_method;
}

# Redact OAuth query strings (code=, token=). Everything else is logged verbatim.
map $request_uri $safe_uri {
    default $request_uri;
    "~*(code|token|access_token|refresh_token|client_secret)=" /<redacted>;
}

server {
    listen 80 default_server;
    server_name __APP_HOST__;
    server_tokens off;

    if ($host != __APP_HOST__) { return 444; }

    client_max_body_size __MAX_ARTIFACT_CONTENT_BYTES__;
    # Headers bounded above the body limit so Nginx rejects oversized headers
    # before the app sees them; two short timers stop slow-header attacks.
    large_client_header_buffers 4 16k;
    client_header_timeout 10s;
    client_body_timeout 30s;
    send_timeout 30s;

    # Overwrite every forwarding header so the app only sees Nginx-controlled values.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Forwarded "for=$remote_addr;proto=$scheme;host=$host";
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;

    access_log /dev/stdout safe;

    location = /mcp {
        access_log off;
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 1h;
    }

    location = /health/live { access_log off; proxy_pass http://app:3000; }
    location = /health/ready { access_log off; proxy_pass http://app:3000; }

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
}
