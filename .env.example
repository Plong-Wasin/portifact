APP_ENV=development
# For a company deployment, use APP_ENV=production and set APP_URL to the
# public HTTPS origin. Register APP_URL/api/auth/callback/microsoft in Entra.
APP_URL=http://localhost
# Used by the included nginx configuration when it is deployed separately.
APP_HOST=localhost
# Container port is fixed at 3000. Change HOST_PORT to change the host port.
PORT=3000
HOST_PORT=3000
TRUST_PROXY=false

DATABASE_URL=postgresql://portifact:change-me-for-local-only@postgres:5432/portifact
POSTGRES_DB=portifact
POSTGRES_USER=portifact
POSTGRES_PASSWORD=change-me-for-local-only

# Required: random string, at least 32 chars. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

REGISTRATION_ENABLED=false
# Production requires all three Microsoft Entra settings. Leave all three
# blank for local development when using the password path. When any Microsoft
# setting is supplied, all three must be supplied and password login and
# registration are disabled.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MAX_ARTIFACT_CONTENT_BYTES=1048576
MAX_STORAGE_BYTES_PER_USER=1073741824
SOFT_DELETE_RETENTION_DAYS=30

ACCESS_TOKEN_TTL_SECONDS=900
IDEMPOTENCY_TTL_SECONDS=86400
SHARE_LINK_ENCRYPTION_KEY=

LOG_LEVEL=info
